# PersonalOpenSourceWebsite — Environment Configuration
# Copy this file to `.env` and fill in your values.
# The project uses python-dotenv; the `.env` file is loaded at runtime from the repo root.

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------

# A long random string used for cryptographic signing.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# Set to True for local development. MUST be False in production.
# Parsed by env_bool(): only 1/true/yes/on (case-insensitive) are truthy.
# Unset, empty, 0, false, no, off are all False.
DEBUG=True

# Comma-separated list of host/domain names the site can serve.
# In production, set this to your domain(s), e.g. ALLOWED_HOSTS=mslevin.dev,www.mslevin.dev
# Empty ALLOWED_HOSTS fail-closes (Django denies every Host).
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional comma-separated CSRF origins, e.g. https://mslevin.dev,https://www.mslevin.dev
# If unset, settings.py derives https:// from non-local ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=

# Trust X-Forwarded-Proto / X-Forwarded-Host. Defaults to true when DEBUG=False.
TRUST_PROXY=

# Force HTTPS redirects. Defaults to true when DEBUG=False.
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False

# -----------------------------------------------------------------------------
# Admin & Error Notifications
# -----------------------------------------------------------------------------

# Name and email that appear in Django error emails / admin notifications.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Contact / SMTP Email
# -----------------------------------------------------------------------------

# Gmail address used to send contact-form emails.
# You must use a Gmail App Password (not your normal Gmail password).
# Instructions: https://support.google.com/mail/answer/185833?hl=en
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
# Local override: django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=

# -----------------------------------------------------------------------------
# Homepage / Public Identity
# -----------------------------------------------------------------------------

# Name displayed on the homepage.
LISTED_NAME=Your Name

# Professional title displayed on the homepage.
LISTED_TITLE=Your Title

# Public contact email displayed on the homepage.
LISTED_EMAIL=contact@example.com

# Public phone number displayed on the homepage (E.164 format recommended, e.g. +155****4567).
LISTED_PHONE=+155****4567

# GitHub profile URL.
LISTED_GITHUB=https://github.com/yourusername

# LinkedIn profile URL.
LISTED_LINKEDIN=https://www.linkedin.com/in/yourusername/

# Twitter/X profile URL (can be left blank if unused).
LISTED_TWITTER=

# Discord invite or profile URL (can be left blank if unused).
LISTED_DISCORD=

# Title used inside body text / blurbs (e.g. "Matt's" or "My").
# NOTE: The Django setting is named LISTED_IN_TEXT_TITLE, but the env var is IN_TEXT_TITLE.
IN_TEXT_TITLE=Your Name's

# Caption for the homepage image / hero section.
HOMEPAGE_IMAGE_CAPTION=A caption for your homepage image

# -----------------------------------------------------------------------------
# Deployment (Railway / Docker)
# -----------------------------------------------------------------------------

# Absolute path to the SQLite database file. On Railway, point this at your
# mounted volume, e.g. DATABASE_PATH=/data/db.sqlite3
# Leave blank for local dev. Empty/unset both resolve to ./db.sqlite3.
DATABASE_PATH=

# Optional. Defaults to ADMIN_EMAIL, then webmaster@localhost.
SERVER_EMAIL=
DEFAULT_FROM_EMAIL=

# Superuser credentials for initial admin creation. Only used by entrypoint.sh
# when the container starts. If either is blank, no superuser is created.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Port gunicorn binds to. Railway injects PORT automatically.
PORT=8000

# Gunicorn worker count. Default is 2.
WEB_CONCURRENCY=2

# Gunicorn worker timeout in seconds. Default is 30.
GUNICORN_TIMEOUT=30
